# Заголовки безопасности для Cloudflare (Workers static assets). Те же правила — в vercel.json.
# Форма заявки (/zayavka) и страница отзыва (/otzyv/...) встраиваются на сайты компании — для них
# запрет встраивания снимаем (! — убрать заголовок, выставленный правилом /*), остальное закрыто.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker (уведомления на телефон, офлайн-экран): браузер должен сразу видеть новую версию.
/sw.js
  Cache-Control: no-cache

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://fleet-weasel-433.convex.cloud https://blissful-giraffe-614.eu-west-1.convex.cloud https://dependable-sheep-588.convex.cloud https://fleet-weasel-433.convex.site https://blissful-giraffe-614.eu-west-1.convex.site https://dependable-sheep-588.convex.site; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://fleet-weasel-433.convex.cloud https://blissful-giraffe-614.eu-west-1.convex.cloud wss://fleet-weasel-433.convex.cloud wss://blissful-giraffe-614.eu-west-1.convex.cloud https://fleet-weasel-433.convex.site https://blissful-giraffe-614.eu-west-1.convex.site https://dependable-sheep-588.convex.cloud wss://dependable-sheep-588.convex.cloud https://dependable-sheep-588.convex.site; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
  Strict-Transport-Security: max-age=63072000

