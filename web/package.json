{
  "name": "servicepro-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "СервисПро — CRM для сервисного бизнеса: заявки, заказы, исполнители, деньги. Фронт — React (Cloudflare Workers), бэкенд — Convex.",
  "scripts": {
    "dev": "vite",
    "convex": "convex dev --typecheck disable",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p convex/tsconfig.json",
    "test": "vitest run",
    "seed": "tsx scripts/seed-convex.ts",
    "deploy:convex": "convex deploy -y --typecheck disable",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@fontsource-variable/inter": "^5.3.0",
    "convex": "^1.46.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "read-excel-file": "^9.3.12",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.60",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.28.2": true
  }
}
